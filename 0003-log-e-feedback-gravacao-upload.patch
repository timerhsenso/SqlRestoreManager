+        <div id="restoreText" class="progress-text">Aguardando envio do arquivo...</div>
     </div>
 
     <div id="error" class="error hidden" role="alert"></div>
@@ -212,6 +212,12 @@
                 $("uploadText").textContent = `${mb(e.loaded)} de ${mb(e.total)} (${pct.toFixed(0)}%)`;
             };
 
+            // Todos os bytes saíram do navegador; o servidor ainda está gravando o arquivo.
+            xhr.upload.onload = () => {
+                $("uploadText").textContent = "Arquivo enviado. Aguardando o servidor gravar o arquivo...";
+                $("restoreText").textContent = "Aguardando o servidor...";
+            };
+
             xhr.onload = () => {
                 if (xhr.status >= 200 && xhr.status < 300) {
                     try { resolve(JSON.parse(xhr.responseText)); }
@@ -251,7 +257,7 @@
         setBar("uploadBar", 0);
         setBar("restoreBar", 0);
         $("uploadText").textContent = "";
-        $("restoreText").textContent = "Aguardando envio...";
+        $("restoreText").textContent = "Aguardando envio do arquivo...";
         $("progressBox").classList.remove("hidden");
 
         const data = new FormData();
