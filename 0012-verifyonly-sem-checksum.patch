From d5abc78c9f7f5dd530686fece17b893b8d7766fd Mon Sep 17 00:00:00 2001
From: claude <c@x>
Date: Thu, 17 Sep 2026 19:02:48 +0000
Subject: [PATCH] VERIFYONLY: usar CHECKSUM apenas quando o backup tiver
 checksums

---
 Services/Jobs/RestoreJobProcessor.cs |  3 ++-
 Services/Sql/SqlRestoreModels.cs     |  4 ++++
 Services/Sql/SqlRestoreService.cs    | 24 +++++++++++++++++++-----
 3 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/Services/Jobs/RestoreJobProcessor.cs b/Services/Jobs/RestoreJobProcessor.cs
index e409b82..e7d424b 100644
--- a/Services/Jobs/RestoreJobProcessor.cs
+++ b/Services/Jobs/RestoreJobProcessor.cs
@@ -103,7 +103,8 @@ public sealed class RestoreJobProcessor
                     VerifyStartPercent, stoppingToken);
 
                 await RunWithProgressAsync(history, "Verificando backup", VerifyStartPercent, SafetyStartPercent,
-                    onSpid => _sql.VerifyBackupAsync(sqlBackup, backup.Position, onSpid, stoppingToken));
+                    onSpid => _sql.VerifyBackupAsync(
+                        sqlBackup, backup.Position, backup.HasChecksums, onSpid, stoppingToken));
             }
 
             await CreateSafetyBackupAsync(history, job.TargetDatabase, stoppingToken);
diff --git a/Services/Sql/SqlRestoreModels.cs b/Services/Sql/SqlRestoreModels.cs
index c5df4db..f5db326 100644
--- a/Services/Sql/SqlRestoreModels.cs
+++ b/Services/Sql/SqlRestoreModels.cs
@@ -5,12 +5,16 @@ public sealed record SqlSessionInfo(int SessionId, string Login, string Host, st
 /// <param name="Type">D = dados, L = log, S = FILESTREAM/memory-optimized, F = full-text.</param>
 public sealed record BackupFile(string LogicalName, string PhysicalName, char Type);
 
+/// <param name="HasChecksums">
+/// O backup foi gerado WITH CHECKSUM. Só então VERIFYONLY/RESTORE podem usar CHECKSUM.
+/// </param>
 public sealed record BackupInspection(
     string SourceDatabase,
     int Position,
     DateTime? BackupFinishDate,
     string? ServerName,
     int SoftwareVersionMajor,
+    bool HasChecksums,
     IReadOnlyList<BackupFile> Files);
 
 /// <param name="SqlServerBackupPath">Caminho do .bak como o SQL Server o enxerga.</param>
diff --git a/Services/Sql/SqlRestoreService.cs b/Services/Sql/SqlRestoreService.cs
index 595118d..7ad994d 100644
--- a/Services/Sql/SqlRestoreService.cs
+++ b/Services/Sql/SqlRestoreService.cs
@@ -74,7 +74,8 @@ public sealed class SqlRestoreService
         await using var cn = await _connections.OpenMasterAsync(ct);
         var serverMajor = await GetServerMajorVersionAsync(cn, ct);
 
-        var sets = new List<(int Position, int Type, string Database, DateTime? Finish, string? Server, int Major)>();
+        var sets = new List<(int Position, int Type, string Database, DateTime? Finish, string? Server, int Major,
+            bool HasChecksums)>();
 
         await using (var header = CreateCommand(cn, "RESTORE HEADERONLY FROM DISK = @bak;", ShortTimeoutSeconds))
         {
@@ -89,7 +90,8 @@ public sealed class SqlRestoreService
                     rd["DatabaseName"] as string ?? string.Empty,
                     rd["BackupFinishDate"] as DateTime?,
                     rd["ServerName"] as string,
-                    Convert.ToInt32(rd["SoftwareVersionMajor"])));
+                    Convert.ToInt32(rd["SoftwareVersionMajor"]),
+                    rd["HasBackupChecksums"] is bool hasChecksums && hasChecksums));
             }
         }
 
@@ -130,7 +132,12 @@ public sealed class SqlRestoreService
         if (files.Count == 0)
             throw new RestoreValidationException("Nenhum arquivo lógico encontrado no backup.");
 
-        return new BackupInspection(full.Database, full.Position, full.Finish, full.Server, full.Major, files);
+        if (!full.HasChecksums)
+            _logger.LogInformation(
+                "Backup gerado sem CHECKSUM: a verificação de integridade será feita sem essa opção.");
+
+        return new BackupInspection(
+            full.Database, full.Position, full.Finish, full.Server, full.Major, full.HasChecksums, files);
     }
 
     // --------------------------------------------------------------- Restore
@@ -200,13 +207,20 @@ public sealed class SqlRestoreService
 
     /// <summary>RESTORE VERIFYONLY: confere se o backup é legível e íntegro.</summary>
     public async Task VerifyBackupAsync(
-        string sqlServerBackupPath, int position, Action<int> onSessionStarted, CancellationToken ct = default)
+        string sqlServerBackupPath,
+        int position,
+        bool hasChecksums,
+        Action<int> onSessionStarted,
+        CancellationToken ct = default)
     {
         await using var cn = await _connections.OpenMasterAsync(ct);
         onSessionStarted(await GetSessionIdAsync(cn, ct));
 
+        // CHECKSUM só é aceito quando o backup foi gerado com essa opção.
+        var options = hasChecksums ? "FILE = @pos, CHECKSUM, STATS = 5" : "FILE = @pos, STATS = 5";
+
         await using var cmd = cn.CreateCommand();
-        cmd.CommandText = "RESTORE VERIFYONLY FROM DISK = @bak WITH FILE = @pos, CHECKSUM, STATS = 5;";
+        cmd.CommandText = $"RESTORE VERIFYONLY FROM DISK = @bak WITH {options};";
         cmd.CommandTimeout = 0;
         AddPathParameter(cmd, "@bak", sqlServerBackupPath);
         cmd.Parameters.Add("@pos", SqlDbType.Int).Value = position;
-- 
2.43.0

