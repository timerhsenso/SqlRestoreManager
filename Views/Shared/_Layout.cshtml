@{
    var action = (ViewContext.RouteData.Values["controller"] as string) ?? "Restore";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} · " : "")SQL Restore Manager</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <span class="brand">SQL Restore Manager</span>
    <nav>
        <a asp-controller="Restore" asp-action="Index" aria-current="@(action == "Restore" ? "page" : null)">Restaurar</a>
        <a asp-controller="Backup" asp-action="Index" aria-current="@(action == "Backup" ? "page" : null)">Backup</a>
        <a asp-controller="History" asp-action="Index" aria-current="@(action == "History" ? "page" : null)">Histórico</a>
    </nav>
</header>
<main>@RenderBody()</main>
<script src="~/js/ui.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
