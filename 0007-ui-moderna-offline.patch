+/* =============================================================================
+   SQL Restore Manager — folha única, sem dependências externas.
+   Tokens → base → componentes → utilitários.
+   ============================================================================= */
+
+:root {
+    --ink: #14202c;
+    --ink-soft: #1d2d3d;
+    --canvas: #eceff3;
+    --surface: #ffffff;
+    --line: #d5dce4;
+    --line-strong: #b9c3ce;
+    --text: #1b2430;
+    --muted: #5a6875;
+    --accent: #0f6b5c;
+    --accent-strong: #0b5449;
+    --danger: #a52016;
+    --danger-soft: #fbe6e4;
+    --warn: #8a5a00;
+    --warn-soft: #fdf1d6;
+    --info-soft: #e4ecf6;
+    --ok-soft: #dcf0e8;
+
+    --radius: 10px;
+    --radius-sm: 6px;
+    --shadow: 0 1px 2px rgba(20, 32, 44, .06), 0 8px 24px rgba(20, 32, 44, .07);
+
+    --sans: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
+    --mono: ui-monospace, "Cascadia Mono", Consolas, "Courier New", monospace;
+}
+
+* { box-sizing: border-box; }
+
+html { -webkit-text-size-adjust: 100%; }
+
+body {
+    margin: 0;
+    background: var(--canvas);
+    color: var(--text);
+    font-family: var(--sans);
+    font-size: 15px;
+    line-height: 1.5;
+}
+
+h1 { font-size: 22px; line-height: 1.25; margin: 0 0 4px; letter-spacing: -.01em; }
+h2 { font-size: 15px; margin: 0 0 14px; }
+p { margin: 0 0 14px; }
+a { color: var(--accent-strong); }
+
+/* ------------------------------------------------------------------ Topo */
+.topbar {
+    background: var(--ink);
+    color: #e8edf2;
+    display: flex;
+    align-items: center;
+    gap: 28px;
+    padding: 0 24px;
+    height: 58px;
+    position: sticky;
+    top: 0;
+    z-index: 5;
+}
+
+.brand { font-weight: 600; letter-spacing: .01em; display: flex; align-items: center; gap: 10px; }
+.brand::before {
+    content: "";
+    width: 9px; height: 9px;
+    border-radius: 50%;
+    background: #35d39a;
+    box-shadow: 0 0 0 4px rgba(53, 211, 154, .18);
+}
+
+.topbar nav { display: flex; gap: 6px; }
+.topbar nav a {
+    color: #b9c6d3;
+    text-decoration: none;
+    padding: 7px 13px;
+    border-radius: var(--radius-sm);
+    font-size: 14px;
+}
+.topbar nav a:hover { background: var(--ink-soft); color: #fff; }
+.topbar nav a[aria-current="page"] { background: var(--ink-soft); color: #fff; }
+
+main { padding: 28px 24px 56px; }
+
+/* ----------------------------------------------------------------- Cards */
+.card {
+    background: var(--surface);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    box-shadow: var(--shadow);
+    max-width: 780px;
+    margin: 0 auto 20px;
+    padding: 24px 26px;
+}
+.card.wide { max-width: 1240px; }
+.card-lead { color: var(--muted); font-size: 14px; }
+
+/* --------------------------------------------------------------- Campos */
+.field { margin-top: 20px; }
+.field:first-of-type { margin-top: 0; }
+
+.label {
+    display: block;
+    font-weight: 600;
+    font-size: 13px;
+    margin-bottom: 7px;
+}
+.hint { color: var(--muted); font-size: 13px; margin: 6px 0 0; }
+
+input[type=text], select, input[type=file] {
+    width: 100%;
+    padding: 10px 12px;
+    border: 1px solid var(--line-strong);
+    border-radius: var(--radius-sm);
+    background: var(--surface);
+    color: inherit;
+    font: inherit;
+    font-size: 14px;
+}
+input[type=text]:focus-visible, select:focus-visible, input[type=file]:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 1px;
+}
+input[type=file] { padding: 8px 10px; }
+select:disabled { background: #f4f6f9; color: var(--muted); }
+
+.choice { display: flex; flex-wrap: wrap; gap: 8px 22px; }
+.choice label, .check {
+    display: flex;
+    align-items: flex-start;
+    gap: 9px;
+    font-size: 14px;
+    cursor: pointer;
+}
+.check { margin-top: 18px; }
+input[type=checkbox], input[type=radio] { margin: 3px 0 0; accent-color: var(--accent); }
+
+/* --------------------------------------------------------------- Botões */
+button {
+    font: inherit;
+    font-size: 14px;
+    font-weight: 600;
+    border: 1px solid transparent;
+    border-radius: var(--radius-sm);
+    padding: 10px 18px;
+    cursor: pointer;
+    background: var(--accent);
+    color: #fff;
+}
+button:hover { background: var(--accent-strong); }
+button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
+button:disabled { opacity: .5; cursor: not-allowed; }
+
+.btn-ghost { background: transparent; color: var(--text); border-color: var(--line-strong); }
+.btn-ghost:hover { background: #f1f4f8; }
+.btn-danger { background: var(--danger); }
+.btn-danger:hover { background: #8a1a12; }
+.btn-small { padding: 7px 12px; font-size: 13px; }
+
+.actions { display: flex; gap: 10px; align-items: center; margin-top: 22px; }
+
+/* ----------------------------------------------------------- Mensagens */
+.alert {
+    margin-top: 16px;
+    padding: 12px 14px;
+    border-radius: var(--radius-sm);
+    font-size: 14px;
+    border: 1px solid transparent;
+}
+.alert-info { background: var(--info-soft); border-color: #c3d4e8; }
+.alert-warn { background: var(--warn-soft); border-color: #eccf90; color: var(--warn); }
+.alert-error { background: var(--danger-soft); border-color: #eab6b1; color: var(--danger); }
+.alert-ok { background: var(--ok-soft); border-color: #a9d8c8; color: var(--accent-strong); white-space: pre-line; }
+.alert ul { margin: 8px 0 0; padding-left: 20px; }
+.alert li { font-family: var(--mono); font-size: 12.5px; }
+
+/* --------------------------------------------- Console de progresso */
+.console {
+    margin-top: 24px;
+    background: var(--ink);
+    border-radius: var(--radius);
+    padding: 18px 20px 20px;
+    color: #cfdae5;
+}
+.console-row + .console-row { margin-top: 18px; }
+.console-head {
+    display: flex;
+    justify-content: space-between;
+    align-items: baseline;
+    font-size: 12px;
+    letter-spacing: .02em;
+    color: #93a4b5;
+}
+.console-head b { color: #e8edf2; font-weight: 600; }
+.console-value { font-family: var(--mono); font-size: 12px; color: #e8edf2; }
+.track {
+    height: 8px;
+    border-radius: 99px;
+    background: #27394b;
+    overflow: hidden;
+    margin-top: 8px;
+}
+.track > div {
+    height: 100%;
+    width: 0;
+    border-radius: 99px;
+    background: linear-gradient(90deg, #35d39a, #2aa7d0);
+    transition: width .35s ease;
+}
+.track.running > div {
+    background-image: linear-gradient(90deg, #35d39a, #2aa7d0),
+                      repeating-linear-gradient(115deg, rgba(255,255,255,.16) 0 10px, transparent 10px 20px);
+    background-blend-mode: overlay;
+    animation: slide 1.1s linear infinite;
+}
+@keyframes slide { to { background-position: 40px 0, 0 0; } }
+.console-note { margin-top: 8px; font-size: 13px; color: #b6c4d2; }
+
+/* -------------------------------------------------------------- Tabela */
+.table-scroll { overflow-x: auto; margin-top: 4px; }
+table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
+th, td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
+th {
+    font-size: 12px;
+    color: var(--muted);
+    font-weight: 600;
+    border-bottom-color: var(--line-strong);
+    white-space: nowrap;
+}
+tbody tr:hover { background: #f7f9fb; }
+td.num { font-family: var(--mono); white-space: nowrap; }
+.sub { color: var(--muted); font-size: 12px; margin-top: 2px; }
+
+.badge {
+    display: inline-block;
+    padding: 3px 9px;
+    border-radius: 99px;
+    font-size: 12px;
+    font-weight: 600;
+    white-space: nowrap;
+}
+.badge-ok { background: var(--ok-soft); color: var(--accent-strong); }
+.badge-warn { background: var(--warn-soft); color: var(--warn); }
+.badge-error { background: var(--danger-soft); color: var(--danger); }
+.badge-active { background: var(--info-soft); color: #1d4f91; }
+
+details summary { cursor: pointer; font-size: 13px; font-weight: 600; color: var(--muted); }
+details[open] summary { margin-bottom: 8px; }
+.log {
+    white-space: pre-wrap;
+    margin: 0;
+    font-family: var(--mono);
+    font-size: 12.5px;
+    background: #f4f6f9;
+    border: 1px solid var(--line);
+    padding: 12px;
+    border-radius: var(--radius-sm);
+}
+
+/* --------------------------------------------------------------- Modal */
+dialog.modal {
+    border: 0;
+    border-radius: var(--radius);
+    padding: 0;
+    width: min(440px, calc(100vw - 32px));
+    box-shadow: 0 20px 60px rgba(9, 16, 24, .3);
+    color: var(--text);
+}
+dialog.modal::backdrop { background: rgba(14, 22, 30, .55); }
+.modal-body { padding: 24px 26px 20px; }
+.modal-body h2 { font-size: 17px; margin-bottom: 8px; }
+.modal-body p { margin: 0; font-size: 14px; color: var(--muted); }
+.modal-foot {
+    display: flex;
+    justify-content: flex-end;
+    gap: 10px;
+    padding: 0 26px 22px;
+}
+
+/* -------------------------------------------------------------- Toasts */
+.toasts {
+    position: fixed;
+    top: 72px;
+    right: 20px;
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    z-index: 20;
+    max-width: min(380px, calc(100vw - 32px));
+}
+.toast {
+    background: var(--surface);
+    border: 1px solid var(--line);
+    border-left: 4px solid var(--muted);
+    border-radius: var(--radius-sm);
+    box-shadow: var(--shadow);
+    padding: 12px 14px;
+    font-size: 14px;
+    white-space: pre-line;
+    animation: toast-in .18s ease-out;
+}
+.toast-ok { border-left-color: var(--accent); }
+.toast-warn { border-left-color: var(--warn); }
+.toast-error { border-left-color: var(--danger); }
+@keyframes toast-in { from { opacity: 0; transform: translateX(12px); } }
+
+/* --------------------------------------------------------- Utilitários */
+.hidden { display: none !important; }
+.muted { color: var(--muted); }
+
+@media (max-width: 640px) {
+    .topbar { gap: 14px; padding: 0 14px; }
+    main { padding: 18px 12px 40px; }
+    .card { padding: 18px 16px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .track > div, .toast { transition: none; animation: none; }
+    .track.running > div { animation: none; }
+}
diff --git a/wwwroot/js/ui.js b/wwwroot/js/ui.js
new file mode 100644
index 0000000..366e990
--- /dev/null
+++ b/wwwroot/js/ui.js
@@ -0,0 +1,75 @@
+/* Modal de confirmação e toasts — sem dependências. */
+(() => {
+    "use strict";
+
+    let toastHost = null;
+
+    function host() {
+        if (!toastHost) {
+            toastHost = document.createElement("div");
+            toastHost.className = "toasts";
+            toastHost.setAttribute("aria-live", "polite");
+            document.body.appendChild(toastHost);
+        }
+        return toastHost;
+    }
+
+    /** type: "info" | "ok" | "warn" | "error" */
+    function toast(message, { type = "info", timeout = 7000 } = {}) {
+        const item = document.createElement("div");
+        item.className = `toast toast-${type}`;
+        item.textContent = message;
+        item.addEventListener("click", () => item.remove());
+        host().appendChild(item);
+
+        if (timeout > 0) setTimeout(() => item.remove(), timeout);
+        return item;
+    }
+
+    /** Substitui window.confirm; devolve Promise<boolean>. */
+    function confirmDialog({ title, message, confirmText = "Confirmar", cancelText = "Cancelar", danger = false }) {
+        return new Promise(resolve => {
+            const dialog = document.createElement("dialog");
+            dialog.className = "modal";
+
+            const body = document.createElement("div");
+            body.className = "modal-body";
+            const heading = document.createElement("h2");
+            heading.textContent = title;
+            const text = document.createElement("p");
+            text.textContent = message;
+            body.append(heading, text);
+
+            const foot = document.createElement("div");
+            foot.className = "modal-foot";
+            const cancel = document.createElement("button");
+            cancel.type = "button";
+            cancel.className = "btn-ghost";
+            cancel.textContent = cancelText;
+            const ok = document.createElement("button");
+            ok.type = "button";
+            ok.className = danger ? "btn-danger" : "";
+            ok.textContent = confirmText;
+            foot.append(cancel, ok);
+
+            dialog.append(body, foot);
+            document.body.appendChild(dialog);
+
+            const close = result => {
+                dialog.close();
+                dialog.remove();
+                resolve(result);
+            };
+
+            cancel.addEventListener("click", () => close(false));
+            ok.addEventListener("click", () => close(true));
+            // Esc fecha nativamente.
+            dialog.addEventListener("cancel", e => { e.preventDefault(); close(false); });
+
+            dialog.showModal();
+            ok.focus();
+        });
+    }
+
+    window.ui = { toast, confirm: confirmDialog };
+})();
